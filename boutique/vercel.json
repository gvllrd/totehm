{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(), camera=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/discover",
      "destination": "https://www.figher.club/discover",
      "permanent": true
    },
    {
      "source": "/discover.html",
      "destination": "https://www.figher.club/discover",
      "permanent": true
    },
    {
      "source": "/discover_lisbon",
      "destination": "https://www.figher.club/discover_lisbon",
      "permanent": true
    },
    {
      "source": "/discover_lisbon.html",
      "destination": "https://www.figher.club/discover_lisbon",
      "permanent": true
    },
    {
      "source": "/get_higher",
      "destination": "https://www.figher.club/get_higher",
      "permanent": true
    },
    {
      "source": "/get_higher.html",
      "destination": "https://www.figher.club/get_higher",
      "permanent": true
    },
    {
      "source": "/play_lisbon_street",
      "destination": "https://www.figher.club/play_lisbon_street",
      "permanent": true
    },
    {
      "source": "/play_lisbon_street.html",
      "destination": "https://www.figher.club/play_lisbon_street",
      "permanent": true
    },
    {
      "source": "/stoner",
      "destination": "https://www.figher.club/stoner",
      "permanent": true
    },
    {
      "source": "/stoner.html",
      "destination": "https://www.figher.club/stoner",
      "permanent": true
    },
    {
      "source": "/stoner_terms",
      "destination": "https://www.figher.club/stoner_terms",
      "permanent": true
    },
    {
      "source": "/stoner_terms.html",
      "destination": "https://www.figher.club/stoner_terms",
      "permanent": true
    },
    {
      "source": "/origins",
      "destination": "https://www.figher.club/origins",
      "permanent": true
    },
    {
      "source": "/origins.html",
      "destination": "https://www.figher.club/origins",
      "permanent": true
    },
    {
      "source": "/assets/signs/:file",
      "destination": "https://www.figher.club/assets/signs/:file",
      "permanent": true
    }
  ]
}

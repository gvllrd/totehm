{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!higherself).*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(self), camera=(self)"
        }
      ]
    },
    {
      "source": "/higherself",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://telegram.org https://*.telegram.org https://*.t.me"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self \"https://web.telegram.org\" \"https://webk.telegram.org\" \"https://webz.telegram.org\"), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/higherself.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://telegram.org https://*.telegram.org https://*.t.me"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self \"https://web.telegram.org\" \"https://webk.telegram.org\" \"https://webz.telegram.org\"), microphone=(), camera=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/totehm",
      "permanent": false
    },
    {
      "source": "/world",
      "destination": "/map",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/x/space",
      "destination": "https://www.totehm.space/"
    },
    {
      "source": "/x/club",
      "destination": "https://www.figher.club/"
    },
    {
      "source": "/vendor/:f*",
      "destination": "https://www.totehm.space/vendor/:f*"
    },
    {
      "source": "/video-capture.mjs",
      "destination": "https://www.totehm.space/video-capture.mjs"
    },
    {
      "source": "/cities.json",
      "destination": "https://www.totehm.space/cities.json"
    },
    {
      "source": "/@:name",
      "destination": "/creator"
    },
    {
      "source": "/search",
      "destination": "/creator"
    }
  ]
}

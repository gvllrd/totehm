{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!higherself).*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(self), camera=(self)"
        }
      ]
    },
    {
      "source": "/higherself",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://telegram.org https://*.telegram.org https://*.t.me"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self \"https://web.telegram.org\" \"https://webk.telegram.org\" \"https://webz.telegram.org\"), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/higherself.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://telegram.org https://*.telegram.org https://*.t.me"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self \"https://web.telegram.org\" \"https://webk.telegram.org\" \"https://webz.telegram.org\"), microphone=(), camera=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/higher",
      "destination": "/chatgpt",
      "permanent": false
    },
    {
      "source": "/higher.html",
      "destination": "/chatgpt",
      "permanent": false
    },
    {
      "source": "/higherself",
      "destination": "/chatgpt",
      "permanent": false
    },
    {
      "source": "/higherself.html",
      "destination": "/chatgpt",
      "permanent": false
    },
    {
      "source": "/club/totehmbot",
      "destination": "/totehm#settings",
      "permanent": false
    },
    {
      "source": "/club/totehmbot.html",
      "destination": "/totehm#settings",
      "permanent": false
    },
    {
      "source": "/chatgpt",
      "has": [
        {
          "type": "host",
          "value": "totehm.com"
        }
      ],
      "destination": "https://www.totehm.com/chatgpt",
      "permanent": false
    },
    {
      "source": "/chatgpt.html",
      "has": [
        {
          "type": "host",
          "value": "totehm.com"
        }
      ],
      "destination": "https://www.totehm.com/chatgpt",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/totehm",
      "permanent": false
    },
    {
      "source": "/world",
      "destination": "/map",
      "permanent": false
    },
    {
      "source": "/next_objective",
      "destination": "/totehm",
      "permanent": false
    },
    {
      "source": "/next_objective.html",
      "destination": "/totehm",
      "permanent": false
    },
    {
      "source": "/totehm_world",
      "destination": "/map",
      "permanent": false
    },
    {
      "source": "/totehm_world.html",
      "destination": "/map",
      "permanent": false
    },
    {
      "source": "/assets/signs/:file",
      "destination": "https://www.totehm.space/assets/signs/:file",
      "permanent": true
    },
    {
      "source": "/club",
      "destination": "https://www.figher.club/",
      "permanent": false
    },
    {
      "source": "/club/creator",
      "destination": "/totehm",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://abujjbkbbiumxrokozph.supabase.co/functions/v1/chatgpt-connector/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://abujjbkbbiumxrokozph.supabase.co/functions/v1/chatgpt-connector/oauth-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://abujjbkbbiumxrokozph.supabase.co/functions/v1/chatgpt-connector/oauth-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://abujjbkbbiumxrokozph.supabase.co/functions/v1/chatgpt-connector/oauth-server"
    },
    {
      "source": "/chatgpt-api",
      "destination": "https://abujjbkbbiumxrokozph.supabase.co/functions/v1/chatgpt-connector"
    },
    {
      "source": "/chatgpt-api/:path*",
      "destination": "https://abujjbkbbiumxrokozph.supabase.co/functions/v1/chatgpt-connector/:path*"
    },
    {
      "source": "/x/space",
      "destination": "https://www.totehm.space/social"
    },
    {
      "source": "/x/club",
      "destination": "https://www.figher.club/create"
    },
    {
      "source": "/vendor/:f*",
      "destination": "https://www.totehm.space/vendor/:f*"
    },
    {
      "source": "/video-capture.mjs",
      "destination": "https://www.totehm.space/video-capture.mjs"
    },
    {
      "source": "/cities.json",
      "destination": "https://www.totehm.space/cities.json"
    },
    {
      "source": "/@:name",
      "destination": "/creator"
    },
    {
      "source": "/search",
      "destination": "/creator"
    }
  ]
}

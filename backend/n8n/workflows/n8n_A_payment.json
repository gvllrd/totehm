   ]
  },
  {
   "parameters": {
    "method": "PATCH",
    "url": "=https://abujjbkbbiumxrokozph.supabase.co/rest/v1/totehm_clothes?id=eq.{{ $json.cloth_id }}&status=eq.draft",
    "options": {},
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "apikey",
       "value": "={{ $vars.SB_SERVICE_KEY }}"
      },
      {
       "name": "Authorization",
       "value": "=Bearer {{ $vars.SB_SERVICE_KEY }}"
      },
      {
       "name": "Content-Type",
       "value": "application/json"
      },
      {
       "name": "Prefer",
       "value": "return=representation"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ status: \"paid\", paid_at: new Date().toISOString(), stripe_payment_intent: $json.payment_intent, email: $json.email, shipping: $json.shipping }) }}"
   },

  {
   "parameters": {
    "jsCode": "\n// why: sans vérif de signature, n'importe qui peut marquer une commande payée\nconst crypto = require('crypto');\nconst sig = $input.first().json.headers['stripe-signature'] || '';\nconst raw = $input.first().binary?.data ? Buffer.from($input.first().binary.data.data, 'base64').toString('utf8') : JSON.stringify($input.first().json.body);\nconst parts = Object.fromEntries(sig.split(',').map(s => s.split('=')));\nconst signed = parts.t + '.' + raw;\nconst expected = crypto.createHmac('sha256', $vars.STRIPE_WHSEC).update(signed).digest('hex');\nif (expected !== parts.v1) throw new Error('bad signature');\nconst event = JSON.parse(raw);\nif (event.type !== 'checkout.session.completed') return [];\nconst s = event.data.object;\nreturn [{ json: {\n  cloth_id: s.metadata.cloth_id,\n  payment_intent: s.payment_intent,\n  email: s.customer_details?.email || null,\n  shipping: s.shipping_details || s.customer_details || {}\n}}];\n"
   },
   "id": "24b5c693-8a98-4e15-93f1-36a4ad969224",
   "name": "Verify Signature + Extract",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,

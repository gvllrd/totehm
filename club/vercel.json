{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(self), camera=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/console",
      "destination": "https://www.totehm.com/console",
      "permanent": true
    },
    {
      "source": "/console.html",
      "destination": "https://www.totehm.com/console",
      "permanent": true
    },
    {
      "source": "/assets/signs/:file",
      "destination": "https://www.totehm.space/assets/signs/:file",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/discover",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/discover.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/discover_lisbon",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/discover_lisbon.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/get_higher",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/get_higher.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/global",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/global.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/lisbon",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/lisbon.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/market",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/market.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/origins",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/origins.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/play_lisbon_street",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/play_lisbon_street.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/stoner",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/stoner.html",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/stoner_terms",
      "destination": "/art-bridge.html"
    },
    {
      "source": "/stoner_terms.html",
      "destination": "/art-bridge.html"
    }
  ]
}

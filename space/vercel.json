{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "spot"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "u"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "habit"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "spot"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "u"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "habit"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/lisbon",
      "destination": "/discover_lisbon",
      "permanent": true
    },
    {
      "source": "/global",
      "destination": "/discover",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/s/:id/i",
      "destination": "/api/card?id=:id&img=1"
    },
    {
      "source": "/s/:id",
      "destination": "/api/card?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "https://www.totehm.com/map", "permanent": true },
    { "source": "/discover", "destination": "https://higher.boutique/discover", "permanent": true },
    { "source": "/discover.html", "destination": "https://higher.boutique/discover", "permanent": true },
    { "source": "/discover_lisbon", "destination": "https://higher.boutique/discover_lisbon", "permanent": true },
    { "source": "/discover_lisbon.html", "destination": "https://higher.boutique/discover_lisbon", "permanent": true },
    { "source": "/get_higher", "destination": "https://higher.boutique/get_higher", "permanent": true },
    { "source": "/get_higher.html", "destination": "https://higher.boutique/get_higher", "permanent": true },
    { "source": "/stoner", "destination": "https://higher.boutique/stoner", "permanent": true },
    { "source": "/stoner.html", "destination": "https://higher.boutique/stoner", "permanent": true },
    { "source": "/stoner_terms", "destination": "https://higher.boutique/stoner_terms", "permanent": true },
    { "source": "/stoner_terms.html", "destination": "https://higher.boutique/stoner_terms", "permanent": true },
    { "source": "/play_lisbon_street", "destination": "https://higher.boutique/play_lisbon_street", "permanent": true },
    { "source": "/play_lisbon_street.html", "destination": "https://higher.boutique/play_lisbon_street", "permanent": true },
    { "source": "/origins", "destination": "https://higher.boutique/origins", "permanent": true },
    { "source": "/origins.html", "destination": "https://higher.boutique/origins", "permanent": true },
    { "source": "/lisbon", "destination": "https://higher.boutique/discover_lisbon", "permanent": true },
    { "source": "/global", "destination": "https://higher.boutique/discover", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}

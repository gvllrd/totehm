{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "spot"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "u"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "habit"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "spot"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "u"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "query",
          "key": "habit"
        }
      ],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "take" }],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "query", "key": "take" }],
      "destination": "/social",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "PT" }],
      "destination": "/lisbon-space",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "PT" }],
      "destination": "/lisbon-space",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/new-york",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/new-york",
      "permanent": false
    },
    {
      "source": "/lisbon",
      "destination": "/play_lisbon_street",
      "permanent": false
    },
    {
      "source": "/discover_lisbon",
      "destination": "/play_lisbon_street",
      "permanent": false
    },
    {
      "source": "/discover_lisbon.html",
      "destination": "/play_lisbon_street",
      "permanent": false
    },
    {
      "source": "/global",
      "destination": "/discover",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/lisbon-space",
      "destination": "/index.html"
    },
    {
      "source": "/new-york",
      "destination": "/index.html"
    },
    {
      "source": "/s/:id/i",
      "destination": "/api/card?id=:id&img=1"
    },
    {
      "source": "/s/:id",
      "destination": "/api/card?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Vary", "value": "X-Vercel-IP-Country" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "Vary", "value": "X-Vercel-IP-Country" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(self), microphone=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
